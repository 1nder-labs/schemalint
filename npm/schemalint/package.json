{
  "name": "@1nder-labs/schemalint",
  "version": "1.2.1",
  "description": "Lint JSON Schema and Zod schemas before OpenAI or Anthropic structured-output APIs reject them.",
  "license": "MIT OR Apache-2.0",
  "author": "Lahfir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1nder-labs/schemalint.git",
    "directory": "npm/schemalint"
  },
  "homepage": "https://1nder-labs.github.io/schemalint",
  "bugs": {
    "url": "https://github.com/1nder-labs/schemalint/issues"
  },
  "keywords": [
    "json-schema",
    "zod",
    "openai",
    "anthropic",
    "structured-output",
    "llm",
    "schema",
    "lint",
    "validation",
    "pydantic"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "schemalint": "./index.cjs"
  },
  "files": [
    "index.cjs",
    "launcher/*.cjs",
    "native-manifest.json",
    "dist/",
    "bin/",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "dependencies": {
    "picomatch": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependencies": {
    "zod": ">=3.20"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  },
  "scripts": {
    "build": "tsc",
    "generate:native-manifest": "node scripts/generate-native-manifest.cjs",
    "prepack": "node scripts/validate-native-manifest.cjs --release",
    "test": "vitest run && npm run test:launcher",
    "test:launcher": "node --test launcher/__tests__/*.test.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
